{
  "name": "elek",
  "version": "1.1.4",
  "description": "Model-agnostic AI code review for GitHub Actions with cross-model validation and a tightly scoped review-only tool surface.",
  "type": "module",
  "homepage": "https://github.com/selimozten/elek",
  "bugs": "https://github.com/selimozten/elek/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/selimozten/elek.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test test/",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "elek-analytics": "./bin/elek-analytics.mjs",
    "elek-benchmark": "./bin/elek-benchmark.mjs",
    "elek-eval": "./bin/elek-eval.mjs",
    "elek-feedback": "./bin/elek-feedback.mjs",
    "elek-init": "./bin/elek-init.mjs"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@octokit/rest": "22.0.1",
    "pi-mcp-adapter": "2.16.0",
    "tsx": "4.23.1",
    "typebox": "1.3.9",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.8",
    "undici": "8.5.0"
  },
  "keywords": [
    "github-actions",
    "code-review",
    "ai",
    "pi-coding-agent",
    "deepseek",
    "anthropic",
    "openai",
    "model-agnostic",
    "cross-model",
    "code-review-bot",
    "mcp",
    "pull-request",
    "automated-review"
  ],
  "license": "MIT"
}
